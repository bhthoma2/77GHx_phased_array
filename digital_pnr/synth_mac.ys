proc; opt; fsm; opt; memory; opt
techmap; opt
dfflibmap -liberty /home/bthomas3/Videos/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
